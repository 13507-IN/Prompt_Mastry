PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prompt_mastry
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
REQUEST_BODY_LIMIT=1mb

# OpenAI Configuration (Required for LangChain features)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo

# LangChain Configuration (Optional - for observability)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=prompt-mastry
LANGCHAIN_API_KEY=

# Feature Flags
ENABLE_ADVANCED_GENERATION=true
ENABLE_STREAMING=true
ENABLE_OPTIMIZATION=true
